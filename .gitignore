# Environment secrets — không được commit
.env
.env.local
.env.*.local
.env*

# Python
__pycache__/
*.pyc
venv/
.venv/

# Node
node_modules/

# Tools
tools/

.vercel

# Build artifacts của auto_build.py / PyInstaller — KHÔNG được commit, virtualenv
# build_env/ một mình đã vài trăm MB, từng làm Vercel bundle vượt giới hạn.
build_env/
build/
dist/

# File cài đặt Desktop App (.exe/.dmg/.app) — build cục bộ rồi upload thủ công lên
# Google Drive/GitHub Releases, KHÔNG push lên Git. Ngoại lệ duy nhất:
# static/downloads/BitPawOS_Setup.exe (file mồi 1KB, add bằng `git add -f`).
*.exe
*.dmg
*.app

# Output tải APK build từ GitHub Actions về máy local để test — không phải source code.
build_output/

# Video thô Playwright (tên ngẫu nhiên, sinh mới mỗi lần chạy script walkthrough, ~16MB/lần) — báo cáo
# chỉ dùng bản đã chọn lọc trong audit-results/report_build/video/, không commit video thô.
audit-results/videos/

# Ảnh gốc icon 3D (nặng) — chỉ dùng để tạo static/icons/3d/*.webp bằng scripts/prepare_3d_icons.py
/3d/
# Ảnh quét thô của linger_audit / full_site_audit (tạo lại được, ~90 MB/lượt) — chỉ commit file kết quả .json
audit-results/linger_audit/*/
audit-results/full_site_audit_round2/*/
