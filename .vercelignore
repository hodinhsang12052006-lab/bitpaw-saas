# File local .env (va cac bien the .env.*) TUYET DOI khong duoc nam trong bundle deploy len
# Vercel - chi dung cho dev local. Server Production phai chi doc bien moi truong THAT do
# chinh Vercel Dashboard inject, khong duoc phep bi 1 file cuc bo (co the co gia tri rong/cu)
# ghi de am tham. (Xem them: mongo_client.py load_env_file() cung da duoc sua de khong bao gio
# ghi de 1 bien da ton tai trong os.environ, phong truong hop file nay van lot vao bundle vi ly
# do khac trong tuong lai.)
.env
.env.*
.env.local
.env.production
.vercel

# Khong phai code chay web — loai khoi bundle serverless. Vercel @vercel/python dong goi TOAN BO
# file trong repo vao function (gioi han 225 MB); rieng audit-results/ (anh chup + video kiem
# thu Playwright) da ~245 MB, lam deploy loi "Total bundle size exceeds the maximum function
# size". Khong file .py/template nao doc toi cac thu muc duoi day (da grep xac nhan).
audit-results/
mobile_app/
scripts/
graphify-out/
graphify_map.json
node_modules/

# Thu muc build Desktop App (.exe) chi co tren may dev, khong nam trong git — loai ra de lenh
# `vercel deploy` chay truc tiep tu may local khong upload nham ~800 MB nay.
build/
build_env/
build_output/
dist/
tools/
