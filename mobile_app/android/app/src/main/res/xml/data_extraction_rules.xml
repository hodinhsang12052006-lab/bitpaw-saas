<?xml version="1.0" encoding="utf-8"?>
<!-- Không sao lưu/chuyển dữ liệu app (cookie phiên đăng nhập của WebView) lên đám mây hay sang máy khác —
     kẻ có bản sao lưu không được dùng lại phiên của chủ tiệm. Android 12+ (Android cũ hơn: allowBackup=false). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
